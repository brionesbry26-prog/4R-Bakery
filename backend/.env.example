# Copy to .env and edit. Never commit the real .env file.

# --- Runtime ---
ENVIRONMENT=development
# SQLite for development. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://bakery:CHANGE_ME@db-host:5432/bakery
# (and add psycopg[binary] to requirements.txt)
DATABASE_URL=sqlite:///./bakery.db
# Comma-separated origins. "*" is ignored when ENVIRONMENT=production.
# Native mobile apps do not send an Origin header, so CORS only matters for web clients.
CORS_ORIGINS=*
LOG_LEVEL=INFO
SEED_SAMPLE_PRODUCTS=true
# Serve the customer website from ../web at http://localhost:8000/
SERVE_WEBSITE=true

# --- Business information ---
# Leave blank until the bakery provides verified details; the app shows
# "not yet configured" instead of inventing them.
BAKERY_NAME=4R Bakery
BAKERY_ADDRESS=Brgy. Bachawan, San Agustin, Romblon, Philippines
BAKERY_PHONE=
BAKERY_EMAIL=
# Free text, e.g. "Mon-Sat 5:00 AM - 7:00 PM"
BAKERY_HOURS=
BAKERY_FACEBOOK_URL=
BAKERY_INSTAGRAM_URL=
# Optional exact Google Maps link. If blank, a Google Maps search URL is generated.
BAKERY_MAP_URL=
BAKERY_TIMEZONE=Asia/Manila

# --- Ordering rules ---
CURRENCY=PHP
# true = enforce and decrement products.stock_quantity on order creation
INVENTORY_TRACKING=false
MIN_PICKUP_LEAD_MINUTES=60
MAX_PICKUP_ADVANCE_DAYS=60
# Optional pickup window (HH:MM, 24h). Both must be set to take effect.
PICKUP_OPEN_TIME=
PICKUP_CLOSE_TIME=
MAX_ITEMS_PER_ORDER=30
MAX_QUANTITY_PER_ITEM=500

# --- Abuse protection ---
MAX_REQUEST_BODY_BYTES=32768
ORDER_RATE_LIMIT_PER_MINUTE=10
LOOKUP_RATE_LIMIT_PER_MINUTE=60
