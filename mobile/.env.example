# Copy to mobile/.env (not committed) and set the backend URL including /api.
#
# Android emulator ............ http://10.0.2.2:8000/api
# iOS simulator ............... http://localhost:8000/api
# Physical phone (same Wi-Fi) . http://<your-computer-LAN-IP>:8000/api   e.g. http://192.168.1.23:8000/api
# Production .................. https://api.your-domain.example/api      (HTTPS required)
#
# Leave unset during development to auto-detect the Expo dev server's IP.
EXPO_PUBLIC_API_BASE_URL=
